# ==============================================================================
# W1™ Aegis-W1 Defense Server Environment Configuration Template (.env.example)
# Copy this file to .env (or /etc/w1_defense/w1.env) and populate with strong
# randomly generated 256-bit hex secrets (e.g., `openssl rand -hex 32`).
# NEVER commit real secrets to version control.
# ==============================================================================

# --- Mandatory Cryptographic Secrets (Fail-Closed if unset) ---
# 256-bit HMAC key for capability token issuance & verification
W1_CAPABILITY_HMAC_KEY=

# Shared bearer secret authorizing supervisor escalation & quarantine overrides
W1_SUPERVISOR_SECRET=

# --- Optional Domain-Specific Cryptographic Secrets ---
# HMAC secret for AirDefenseInterceptor IFF challenge-response verification
W1_IFF_SECRET=

# HMAC secret for EvaluationGraderVault scorecard attestation
W1_GRADER_HMAC_KEY=

# HMAC secret for ImmutableTestVault test file sealing
W1_VAULT_HMAC_KEY=

# HMAC secret for AgentSecurityTrainer certification signing
W1_TRAINER_SECRET=

# --- Network & Server Binding ---
# Bind address (default: 127.0.0.1 for local-only isolation)
W1_HOST=127.0.0.1

# AiTestbedGateway listening port
W1_GATEWAY_PORT=8081

# LiveAIFirewallProxy listening port
W1_PROXY_PORT=8080

# Optional upstream LLM HTTPS endpoint (leave empty for SIMULATION mode)
# Example: https://api.openai.com/v1/chat/completions
W1_UPSTREAM_URL=

# --- Enterprise SOC / SIEM Audit Export (Optional) ---
# Append-only NDJSON security audit log path
W1_AUDIT_LOG_PATH=

# HTTPS webhook endpoint for asynchronous SOC/SIEM alert ingestion
W1_SIEM_WEBHOOK_URL=

# Short webhook delivery timeout in milliseconds (default: 2000)
W1_SIEM_TIMEOUT_MS=2000

# --- HTTP Slowloris & Health Probe Timeouts ---
W1_HEADERS_TIMEOUT_MS=10000
W1_REQUEST_TIMEOUT_MS=30000
W1_KEEPALIVE_TIMEOUT_MS=5000
